# =============================================================================
# YAKU ALERT — UNT (Backend) · Variables de entorno de ejemplo
# Copiar como `.env` para pruebas locales. NUNCA subir `.env` ni tokens a Git.
# =============================================================================

# Ruta opcional de base de datos SQLite embebida (default: backend/app/data/yaku_alert.db)
# YAKU_DB_PATH=

# -----------------------------------------------------------------------------
# WhatsApp Cloud API (Meta for Developers / Graph API — Sandbox TRL 3-4)
# -----------------------------------------------------------------------------
# Activar envío real (false = modo simulado seguro sin llamadas externas)
WHATSAPP_ENABLED=false

# Versión de Meta Graph API
WHATSAPP_API_VERSION=v22.0

# ID del número telefónico de prueba (Meta App Dashboard -> WhatsApp -> API Setup)
WHATSAPP_PHONE_NUMBER_ID=

# Token de acceso temporal o permanente del sandbox (NUNCA commitear valores reales)
WHATSAPP_ACCESS_TOKEN=

# Lista separada por comas de números de prueba autorizados en formato internacional sin "+"
# Ejemplo: 51999999999,51988888888
WHATSAPP_TEST_RECIPIENTS=

# Plantilla de respaldo opcional si la ventana de conversación de 24 h está cerrada (error 131047)
WHATSAPP_TEMPLATE_NAME=hello_world
